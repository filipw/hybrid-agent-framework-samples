{
  "profiles": {
    "<ProjectName>": {
      "commandName": "Project",
      "environmentVariables": {

        "OPENAI_ENDPOINT": "https://<resource>.openai.azure.com/openai/v1",
        "OPENAI_API_KEY": "<your-api-key>",
        "OPENAI_LLM_MODEL": "<deployment-or-model-name>",

        "FOUNDRY_LOCAL_ENDPOINT": "http://127.0.0.1:<port>",
        "FOUNDRY_LOCAL_SLM_MODEL": "phi-4-mini"

      }
    }
  }
}
